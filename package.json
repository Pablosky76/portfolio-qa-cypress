{
  "name": "portfolio-qa-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E del portfolio interactivo de Pablo Gutiérrez Mata",
  "scripts": {
    "test": "cypress run",
    "cy:open": "cypress open",
    "test:entrada": "cypress run --spec 'cypress/e2e/entrada/**/*.cy.js'",
    "test:navegacion": "cypress run --spec 'cypress/e2e/navegacion/**/*.cy.js'",
    "test:contenido": "cypress run --spec 'cypress/e2e/contenido/**/*.cy.js'",
    "test:documentos": "cypress run --spec 'cypress/e2e/documentos/**/*.cy.js'",
    "test:responsive": "cypress run --spec 'cypress/e2e/responsive/**/*.cy.js'",
    "test:interacciones": "cypress run --spec 'cypress/e2e/interacciones/**/*.cy.js'",
    "test:smoke": "cypress run --spec 'cypress/e2e/entrada/**/*.cy.js,cypress/e2e/navegacion/**/*.cy.js,cypress/e2e/contenido/**/*.cy.js,cypress/e2e/documentos/**/*.cy.js,cypress/e2e/responsive/**/*.cy.js'",
    "test:realm": "npm run test:interacciones"
  },
  "devDependencies": {
    "cypress": "15.15.0",
    "cypress-mochawesome-reporter": "4.0.2"
  }
}
