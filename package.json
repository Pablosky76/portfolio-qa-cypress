{
  "name": "portfolio-qa-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E del portfolio interactivo de Pablo Gutiérrez Mata",
  "scripts": {
    "test": "cypress run --browser chrome",
    "cy:open": "cypress open",
    "test:entrada": "cypress run --browser chrome --spec 'cypress/e2e/entrada/bienvenida.cy.js'",
    "test:navegacion": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/perfil.cy.js'",
    "test:contenido": "cypress run --browser chrome --spec 'cypress/e2e/entrada/contenido-perfil.cy.js'",
    "test:documentos": "cypress run --browser chrome --spec 'cypress/e2e/entrada/cv.cy.js'",
    "test:responsive": "cypress run --browser chrome --spec 'cypress/e2e/entrada/perfil-responsive.cy.js'",
    "test:interacciones": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/paneles-reino.cy.js'",
    "test:smoke": "cypress run --browser chrome --spec 'cypress/e2e/entrada/bienvenida.cy.js,cypress/e2e/navegacion/perfil.cy.js,cypress/e2e/entrada/contenido-perfil.cy.js,cypress/e2e/entrada/cv.cy.js,cypress/e2e/entrada/perfil-responsive.cy.js'",
    "test:realm": "npm run test:interacciones",
    "test:tanda1": "cypress run --browser chrome --spec 'cypress/e2e/entrada/bienvenida.cy.js,cypress/e2e/navegacion/perfil.cy.js,cypress/e2e/entrada/contenido-perfil.cy.js,cypress/e2e/entrada/cv.cy.js,cypress/e2e/entrada/perfil-responsive.cy.js,cypress/e2e/navegacion/paneles-reino.cy.js,cypress/e2e/personaje/acciones.cy.js,cypress/e2e/personaje/preferencias.cy.js,cypress/e2e/navegacion/castillo.cy.js'",
    "test:tanda2": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/teclado.cy.js,cypress/e2e/navegacion/mapa.cy.js,cypress/e2e/personaje/pantallas.cy.js,cypress/e2e/entrada/contacto.cy.js,cypress/e2e/personaje/camara.cy.js,cypress/e2e/personaje/movimiento.cy.js'",
    "test:tanda3": "cypress run --browser chrome --spec 'cypress/e2e/persistencia/visitas.cy.js,cypress/e2e/persistencia/almacenamiento.cy.js,cypress/e2e/persistencia/fallos.cy.js,cypress/e2e/accesibilidad/entrada-movil.cy.js,cypress/e2e/accesibilidad/otros-estados.cy.js,cypress/e2e/accesibilidad/paginas.cy.js,cypress/e2e/accesibilidad/reino.cy.js'",
    "test:mundo3d": "cypress run --browser chrome --spec 'cypress/e2e/personaje/acciones.cy.js'",
    "test:ajustes": "cypress run --browser chrome --spec 'cypress/e2e/personaje/preferencias.cy.js'",
    "test:castillo": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/castillo.cy.js'",
    "test:teclado": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/teclado.cy.js'",
    "test:mapa": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/mapa.cy.js'",
    "test:adaptacion3d": "cypress run --browser chrome --spec 'cypress/e2e/personaje/pantallas.cy.js'",
    "test:contacto": "cypress run --browser chrome --spec 'cypress/e2e/entrada/contacto.cy.js'",
    "test:persistencia": "cypress run --browser chrome --spec 'cypress/e2e/persistencia/visitas.cy.js'",
    "test:recuperacion": "cypress run --browser chrome --spec 'cypress/e2e/persistencia/almacenamiento.cy.js,cypress/e2e/persistencia/fallos.cy.js'",
    "test:accesibilidad": "cypress run --browser chrome --spec 'cypress/e2e/accesibilidad/entrada-movil.cy.js,cypress/e2e/accesibilidad/otros-estados.cy.js,cypress/e2e/accesibilidad/paginas.cy.js,cypress/e2e/accesibilidad/reino.cy.js'",
    "test:camara": "cypress run --browser chrome --spec 'cypress/e2e/personaje/camara.cy.js'",
    "test:movimiento": "cypress run --browser chrome --spec 'cypress/e2e/personaje/movimiento.cy.js'",
    "test:area:entrada": "cypress run --browser chrome --spec 'cypress/e2e/entrada/**/*.cy.js'",
    "test:area:navegacion": "cypress run --browser chrome --spec 'cypress/e2e/navegacion/**/*.cy.js'",
    "test:area:personaje": "cypress run --browser chrome --spec 'cypress/e2e/personaje/**/*.cy.js'",
    "test:area:persistencia": "cypress run --browser chrome --spec 'cypress/e2e/persistencia/**/*.cy.js'",
    "test:area:accesibilidad": "cypress run --browser chrome --spec 'cypress/e2e/accesibilidad/**/*.cy.js'"
  },
  "devDependencies": {
    "@testing-library/cypress": "10.1.3",
    "axe-core": "4.14.0",
    "cypress": "15.21.1",
    "cypress-axe": "1.7.0",
    "cypress-mochawesome-reporter": "5.0.0",
    "cypress-real-events": "1.15.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "mocha": {
      "glob": "14.0.6",
      "minimatch": "11.0.8"
    }
  }
}
